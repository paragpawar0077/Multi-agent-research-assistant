GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Point this at Second_brain/backend/chroma_db on your machine — the exact
# folder next to ai_second_brain.db in your backend/ directory.
CHROMA_DB_PATH=/path/to/Second_brain/backend/chroma_db

# Collection name is hardcoded to "document_chunks" in retrieval.py to match
# vector_service.py exactly — not set here, nothing to configure.

# Your Second Brain account's numeric user id. Confirmed from the actual DB:
# paragpawar0077@gmail.com is user_id=2. (user_id=1 is a seed "testuser"
# account — don't use that one.)
SECOND_BRAIN_USER_ID=2
